NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://game:game@localhost:5432/grid_mmorpg?schema=public
# Optional direct connection used by Prisma CLI migrations in hosted environments.
# DIRECT_URL=postgresql://game:game@localhost:5432/grid_mmorpg?schema=public
GAME_REALM_SLUG=world-1
GAME_REALM_NAME=World 1
GAME_REALM_INSTANCE_ID=world-1-primary
CORS_ORIGINS=http://localhost:5173

MOVE_STEP_MS=200
AUTOSAVE_INTERVAL_MS=5000
AUTOSAVE_CONCURRENCY=16
FOV_HALF_WIDTH=12
FOV_HALF_HEIGHT=8
MAX_FOV_HALF_WIDTH=24
MAX_FOV_HALF_HEIGHT=18
SPATIAL_BUCKET_SIZE=16
MAX_PATH_STEPS=96
MAX_PATH_NODES=4096
SOCKET_MAX_PAYLOAD_BYTES=65536
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000

FIREBASE_PROJECT_ID=ai-new-752ac
FIREBASE_CHECK_REVOKED=true
# Use Application Default Credentials in production, or provide one of the values below.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-service-account-json

# Optional. When set, Socket.IO uses the Redis adapter. The realm simulation still uses
# a single-writer process; use Redis for gateway fan-out or future map-worker routing.
REDIS_URL=redis://localhost:6379
GOOGLE_APPLICATION_CREDENTIALS=firebase_key.json