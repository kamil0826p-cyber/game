generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  engineType             = "client"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum CharacterClass {
  MAGE
  WARRIOR
  ARCHER
}

enum UserRole {
  USER
  MOD
  ADMIN
}

enum Direction {
  NORTH
  EAST
  SOUTH
  WEST
}

enum ZoneType {
  SAFE
  OUTLAW
  PVP
}

enum CombatState {
  IDLE
  IN_BATTLE
}

enum SkillTargeting {
  SELF
  ENEMY
  AREA
}

enum EquipmentSlot {
  HEAD
  CHEST
  LEGS
  FEET
  MAIN_HAND
  OFF_HAND
  AMULET
  RING
}

enum QuestProgressStatus {
  NOT_STARTED
  ACTIVE
  COMPLETED
  REWARDED
  FAILED
}

enum ChatChannelType {
  GLOBAL
  REALM
  MAP
  PARTY
  GUILD
  PRIVATE
  SYSTEM
}

enum TradeStatus {
  REQUESTED
  OPEN
  LOCKED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum CurrencyType {
  SILVER
  GOLD
}

enum CurrencyDirection {
  CREDIT
  DEBIT
}

model Realm {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(64)
  name         String   @db.VarChar(120)
  isActive     Boolean  @default(true)
  defaultMapId String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  defaultMap   Map?          @relation("RealmDefaultMap", fields: [defaultMapId], references: [id], onDelete: SetNull)
  maps         Map[]         @relation("RealmMaps")
  characters   Character[]
  chatMessages ChatMessage[]

  @@index([isActive])
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique @db.VarChar(128)
  email       String?  @unique @db.VarChar(320)
  displayName String?  @db.VarChar(120)
  role        UserRole @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characters Character[]

  @@index([role])
}

model Character {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  realmId    String         @db.Uuid
  name       String         @db.VarChar(24)
  class      CharacterClass
  level      Int            @default(1)
  experience Int            @default(0)
  outfitKey  String         @db.VarChar(64)

  mapId       String      @db.Uuid
  x           Int
  y           Int
  direction   Direction   @default(SOUTH)
  combatState CombatState @default(IDLE)

  hp           Int
  maxHp        Int
  energy       Int
  maxEnergy    Int
  strength     Int
  agility      Int
  intelligence Int
  armor        Int
  silver       Int @default(0)
  gold         Int @default(0)

  stateVersion Int      @default(0)
  lastSavedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  realm Realm @relation(fields: [realmId], references: [id], onDelete: Restrict)
  map   Map   @relation(fields: [mapId], references: [id], onDelete: Restrict)

  skills           CharacterSkill[]
  inventoryItems   InventoryItem[]
  quests           CharacterQuest[]
  currencyLedger   CharacterCurrencyLedger[]
  sentChatMessages ChatMessage[]             @relation("ChatSender")
  receivedWhispers ChatMessage[]             @relation("ChatTarget")
  initiatedTrades  TradeSession[]            @relation("TradeInitiator")
  receivedTrades   TradeSession[]            @relation("TradeRecipient")
  tradeOffers      TradeOfferItem[]

  @@unique([realmId, name])
  @@index([userId, realmId])
  @@index([realmId, mapId])
  @@index([mapId, x, y])
}

model CharacterCurrencyLedger {
  id           String            @id @default(uuid()) @db.Uuid
  characterId  String            @db.Uuid
  operationId  String            @db.VarChar(128)
  currency     CurrencyType
  direction    CurrencyDirection
  amount       Int
  reason       String            @db.VarChar(96)
  balanceAfter Int
  metadata     Json              @default("{}") @db.JsonB
  createdAt    DateTime          @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, operationId])
  @@index([characterId, createdAt])
}

model Map {
  id        String   @id @default(uuid()) @db.Uuid
  realmId   String   @db.Uuid
  key       String   @db.VarChar(96)
  name      String   @db.VarChar(160)
  width     Int
  height    Int
  zoneType  ZoneType @default(SAFE)
  spawnX    Int
  spawnY    Int
  tiledData Json     @db.JsonB
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  realm              Realm           @relation("RealmMaps", fields: [realmId], references: [id], onDelete: Cascade)
  defaultForRealms   Realm[]         @relation("RealmDefaultMap")
  characters         Character[]
  sourcePortals      Portal[]        @relation("SourceMap")
  destinationPortals Portal[]        @relation("DestinationMap")
  npcDefinitions     NpcDefinition[]
  mobDefinitions     MobDefinition[]

  @@unique([realmId, key])
  @@index([realmId, zoneType])
}

model Portal {
  id               String   @id @default(uuid()) @db.Uuid
  sourceMapId      String   @db.Uuid
  sourceX          Int
  sourceY          Int
  destinationMapId String   @db.Uuid
  targetX          Int
  targetY          Int
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourceMap      Map @relation("SourceMap", fields: [sourceMapId], references: [id], onDelete: Cascade)
  destinationMap Map @relation("DestinationMap", fields: [destinationMapId], references: [id], onDelete: Restrict)

  @@unique([sourceMapId, sourceX, sourceY])
  @@index([destinationMapId])
}

model SkillDefinition {
  id               String          @id @default(uuid()) @db.Uuid
  key              String          @unique @db.VarChar(96)
  name             String          @db.VarChar(120)
  description      String          @db.Text
  requiredClass    CharacterClass?
  minimumLevel     Int             @default(1)
  energyCost       Int             @default(0)
  cooldownTurns    Int             @default(0)
  targeting        SkillTargeting  @default(ENEMY)
  maxRank          Int             @default(1)
  displayOrder     Int             @default(0)
  treeRow          Int             @default(0)
  treeColumn       Int             @default(0)
  icon             String          @default("✦") @db.VarChar(16)
  prerequisiteKeys Json            @default("[]") @db.JsonB
  effects          Json            @default("[]") @db.JsonB
  animationKey     String          @default("basic-cast") @db.VarChar(96)
  visual           Json            @default("{}") @db.JsonB
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  characters CharacterSkill[]

  @@index([requiredClass, minimumLevel, displayOrder])
}

model CharacterSkill {
  id                String   @id @default(uuid()) @db.Uuid
  characterId       String   @db.Uuid
  skillDefinitionId String   @db.Uuid
  rank              Int      @default(1)
  unlockedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  character       Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skillDefinition SkillDefinition @relation(fields: [skillDefinitionId], references: [id], onDelete: Cascade)

  @@unique([characterId, skillDefinitionId])
  @@index([characterId, unlockedAt])
}

model ItemDefinition {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @unique @db.VarChar(96)
  name        String       @db.VarChar(120)
  description String       @db.Text
  category    ItemCategory
  stackLimit  Int          @default(1)
  metadata    Json         @default("{}") @db.JsonB
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  inventoryItems InventoryItem[]
}

enum ItemCategory {
  EQUIPMENT
  CONSUMABLE
  MATERIAL
  QUEST
}

model InventoryItem {
  id               String         @id @default(uuid()) @db.Uuid
  characterId      String         @db.Uuid
  itemDefinitionId String         @db.Uuid
  quantity         Int            @default(1)
  slotIndex        Int
  equippedSlot     EquipmentSlot?
  durability       Int?
  instanceData     Json           @default("{}") @db.JsonB
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  character      Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemDefinition ItemDefinition @relation(fields: [itemDefinitionId], references: [id], onDelete: Restrict)
  tradeOffers    TradeOfferItem[]

  @@unique([characterId, slotIndex])
  @@index([characterId, equippedSlot])
  @@index([itemDefinitionId])
}

model NpcDefinition {
  id                String   @id @default(uuid()) @db.Uuid
  realmId           String   @db.Uuid
  mapId             String   @db.Uuid
  key               String   @db.VarChar(96)
  name              String   @db.VarChar(120)
  x                 Int
  y                 Int
  outfitKey         String   @db.VarChar(64)
  interactionType   String   @db.VarChar(32)
  interactionRadius Int      @default(1)
  dialogue          Json     @default("{}") @db.JsonB
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  realm Realm @relation(fields: [realmId], references: [id], onDelete: Cascade)
  map   Map   @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@unique([realmId, key])
  @@index([mapId, enabled])
}

model MobDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  realmId        String   @db.Uuid
  mapId          String   @db.Uuid
  key            String   @db.VarChar(96)
  speciesKey     String   @db.VarChar(96)
  name           String   @db.VarChar(120)
  rank           String   @db.VarChar(32)
  characterClass CharacterClass
  level          Int
  outfitKey      String   @db.VarChar(96)
  x              Int
  y              Int
  respawnMs      Int
  experience     Int
  stats          Json     @default("{}") @db.JsonB
  lootTable      Json     @default("[]") @db.JsonB
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  realm Realm @relation(fields: [realmId], references: [id], onDelete: Cascade)
  map   Map   @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@unique([realmId, key])
  @@unique([mapId, x, y])
  @@index([mapId, enabled])
  @@index([realmId, speciesKey])
}

model QuestDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(96)
  title       String   @db.VarChar(160)
  description String   @db.Text
  definition  Json     @db.JsonB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  characterQuests CharacterQuest[]
}

model CharacterQuest {
  id                String              @id @default(uuid()) @db.Uuid
  characterId       String              @db.Uuid
  questDefinitionId String              @db.Uuid
  status            QuestProgressStatus @default(NOT_STARTED)
  progress          Json                @default("{}") @db.JsonB
  acceptedAt        DateTime?
  completedAt       DateTime?
  updatedAt         DateTime            @updatedAt

  character       Character       @relation(fields: [characterId], references: [id], onDelete: Cascade)
  questDefinition QuestDefinition @relation(fields: [questDefinitionId], references: [id], onDelete: Cascade)

  @@unique([characterId, questDefinitionId])
  @@index([characterId, status])
}

model ChatMessage {
  id                String          @id @default(uuid()) @db.Uuid
  realmId           String          @db.Uuid
  mapId              String?         @db.Uuid
  senderCharacterId String?         @db.Uuid
  targetCharacterId String?         @db.Uuid
  channelType       ChatChannelType
  body              String          @db.VarChar(500)
  metadata          Json            @default("{}") @db.JsonB
  createdAt         DateTime        @default(now())

  realm Realm @relation(fields: [realmId], references: [id], onDelete: Cascade)
  senderCharacter Character? @relation("ChatSender", fields: [senderCharacterId], references: [id], onDelete: SetNull)
  targetCharacter Character? @relation("ChatTarget", fields: [targetCharacterId], references: [id], onDelete: SetNull)

  @@index([realmId, channelType, createdAt])
  @@index([mapId, createdAt])
  @@index([targetCharacterId, createdAt])
}

model TradeSession {
  id                   String      @id @default(uuid()) @db.Uuid
  initiatorCharacterId String      @db.Uuid
  recipientCharacterId String      @db.Uuid
  status               TradeStatus @default(REQUESTED)
  initiatorAccepted    Boolean     @default(false)
  recipientAccepted    Boolean     @default(false)
  initiatorSilver      Int         @default(0)
  recipientSilver      Int         @default(0)
  expiresAt            DateTime
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  initiator Character @relation("TradeInitiator", fields: [initiatorCharacterId], references: [id], onDelete: Cascade)
  recipient Character @relation("TradeRecipient", fields: [recipientCharacterId], references: [id], onDelete: Cascade)
  offers    TradeOfferItem[]

  @@index([initiatorCharacterId, status])
  @@index([recipientCharacterId, status])
  @@index([expiresAt, status])
}

model TradeOfferItem {
  id              String   @id @default(uuid()) @db.Uuid
  tradeSessionId  String   @db.Uuid
  characterId     String   @db.Uuid
  inventoryItemId String   @db.Uuid
  quantity        Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tradeSession  TradeSession  @relation(fields: [tradeSessionId], references: [id], onDelete: Cascade)
  character     Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([tradeSessionId, inventoryItemId])
  @@index([tradeSessionId, characterId])
}
