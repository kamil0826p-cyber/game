{
  "name": "margonem-grid-mmorpg-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React and PixiJS browser client for the grid MMORPG backend.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "predev": "npm run outfits:generate && npm --prefix .. run prisma:seed",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "assets:generate": "node scripts/generate-assets.mjs",
    "outfits:generate": "node scripts/generate-outfits.mjs",
    "prebuild": "npm run outfits:generate",
    "pretest": "npm run outfits:generate"
  },
  "dependencies": { "firebase": "11.10.0", "pixi.js": "8.11.0", "react": "19.1.1", "react-dom": "19.1.1", "socket.io-client": "4.8.1" },
  "devDependencies": { "@tailwindcss/vite": "4.1.11", "@types/node": "22.15.30", "@types/react": "19.1.9", "@types/react-dom": "19.1.7", "@vitejs/plugin-react": "4.6.0", "prettier": "3.6.2", "tailwindcss": "4.1.11", "typescript": "5.9.2", "vite": "7.1.1", "vitest": "3.2.4" },
  "packageManager": "npm@10.9.2"
}
